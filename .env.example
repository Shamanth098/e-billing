# Ebilling Web Application Environment Variables Configuration Template
# Copy this file to '.env' and fill in your actual credentials before running the application.

# Server Port
PORT=3000

# Express Session Secret Key (Change this to a random secure string in production)
SESSION_SECRET=ebilling_super_secret_session_key_12345

# MongoDB Atlas Connection URI
# Replace '<db_password>' with your actual MongoDB Atlas database user password.
# If your password contains special characters (like '@' or ':'), they will be automatically encoded by the connection wrapper.
MONGODB_URI=mongodb+srv://shamanthgb0987_db_user:<db_password>@cluster0.sxvvaki.mongodb.net/ebilling?retryWrites=true&w=majority&appName=Cluster0
